<?xml version="1.0" encoding="utf-8"?>
<!-- Mímir's icon: a near-black background and the glowing cyan closed eye, kept inside the 66 dp
     safe circle so no launcher mask crops it (no separate rim: it would be cut or doubled by the
     different masks); the themed icon is the closed eye alone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
